app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment Variables
.env
*.env
.env.*
# ...but the template is documentation, not configuration.
!server/.env.example

# Firebase client config is deliberately committed. These files hold client
# identifiers, not secrets -- Google ships the same values inside every
# published APK/IPA, and firebase_options.dart already carries them. Firestore
# rules are the actual access boundary; App Check is the abuse boundary and is
# a pre-launch task. Ignoring these only breaks fresh clones and CI.

# Signing / Key files
*.p12
*.jks
*.keystore
*.key
*.pem

# Agent tooling, tests and internal reports.
# The published repo carries the app (lib/, assets/, platform config) and the
# AI proxy it talks to (server/). Everything below documents how the app is
# built, tested or hardened, which is not something to hand to anyone reading
# the public repo.
.agent/
.claude/
skills-lock.json

# Tests and test plans
test/
integration_test/
test_driver/

# Security and release documentation
SECURITY_AGENT_PLAN.md
SECURITY_GUIDE.md
TEST_PLAN_V1.md
FINAL_TEST_REPORT.md
EXECUTIVE_SUMMARY.md

# Internal process notes
docs/commit-scopes/

# One-off migration scripts kept locally after they have been run
tool/tmp_*

# Generated by `flutter gen-l10n` on every build (see l10n.yaml)
untranslated_messages.txt

# Scratch artwork that never ships; the real assets live in assets/svgs/
assets/svgs_dev/

# Build Instructions (Optional security)
BUILD_INSTRUCTIONS.md
INSTALL_GUIDE.md
IOS_BUILD_GUIDE.md
IOS_WHICH_METHOD.md
OFFLINE_MODE.md
QUICK_BUILD.md
TESTER_GUIDE.md

# Proxy dependencies and its real configuration (see server/.env.example).
server/node_modules/
server/.env
