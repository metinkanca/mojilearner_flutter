# Copy to .env and fill in. .env is gitignored; this file is not.

# Provider key. The whole point of this service is that this value lives here
# and never in the app binary.
GEMINI_API_KEY=

# Bearer token the app must present. Set the same value in the app build:
#   flutter build apk --dart-define=AI_PROXY_TOKEN=...
# Without it the service refuses to start, because an open proxy holding the
# key above is a free Gemini account for anyone who finds the URL.
AI_PROXY_TOKEN=

# Models the app is allowed to ask for, comma separated. The app chooses the
# model per request, so this is what stops the key being pointed at the most
# expensive one available.
#
# Both are listed so the app can be moved between them with a build flag
# (--dart-define=AI_MODEL=...) and no redeploy of this service. 3.1 Flash Lite
# is the default: cheapest of the available models, and the only cheap one
# that still accepts thinkingBudget:0. The 2.5 family is NOT listed because it
# is closed to new API keys.
#
# 3.7 Flash is the step up if quality needs it, but price it before reaching
# for it: as of 2026-08-30 it is $0.75/$3.75 per M, double what was recorded
# when it was picked as the fallback, and now identical to 3.6 Flash. That is
# 2.6x the cost of 3.1 Flash Lite per turn. Run `npm run eval:prices`.
ALLOWED_MODELS=gemini-3.1-flash-lite,gemini-3.7-flash
DEFAULT_MODEL=gemini-3.1-flash-lite

# Browser origins allowed to call this service, comma separated. Leave EMPTY
# in production: a web build ships AI_PROXY_TOKEN in its JS bundle, so opening
# this turns a readable token into a usable one from any page. Native builds
# never send an Origin and do not need it. For `flutter run -d chrome`, which
# picks a random port each run, use "*" locally and nothing else.
#   CORS_ORIGINS=*

# Idle minutes before a chat session is dropped from memory.
SESSION_TTL_MINUTES=30

PORT=8080

# Only for a throwaway local run. Skips the AI_PROXY_TOKEN requirement.
# ALLOW_UNAUTHENTICATED=true

# --- Spend controls -------------------------------------------------------
#
# These exist because AI_PROXY_TOKEN is shared by every install and can be
# extracted from the APK, so this service cannot tell one user from another.
# They are ceilings on the deployment, not quotas on a person; a real per-user
# quota needs the app to send a Firebase ID token, which needs an app release.

# Hard ceiling on what this service may spend per UTC day, in USD. Once it is
# reached every billable endpoint answers 429 and the app falls back to its
# local behaviour ("Moji is dozing...") until midnight UTC.
#
# UNSET MEANS NO CEILING. The service starts with a warning rather than
# refusing, so an existing deployment still boots after an upgrade — but a
# public proxy holding a billable key should not run without this.
#
# For scale: at the prices in src/pricing.js, $1/day is roughly 2,000 chat
# turns on gemini-3.1-flash-lite.
DAILY_BUDGET_USD=5

# Requests per minute per source address, or 0 to disable.
#
# Deliberately generous. Mobile traffic arrives through carrier-grade NAT where
# many unrelated users share one address, so this is sized to stop a script
# rather than to ration a person — the app's own cooldown caps a real user near
# 20 requests a minute. DAILY_BUDGET_USD is the control that actually bounds
# the bill; this one just stops a single caller monopolising it.
RATE_LIMIT_PER_MINUTE=600

# Set to true ONLY when something in front of this service sets
# X-Forwarded-For — every managed host (Cloud Run, Fly, Railway, Render) does.
# Without it every request behind a load balancer shares one address and the
# rate limit meters the balancer. With it on an unproxied deployment, any
# caller can forge the header and hand themselves a fresh quota per request.
TRUST_PROXY=true

# Messages kept per conversation, oldest dropped first. The provider is
# stateless, so every turn re-sends the whole history at the input rate: an
# untrimmed chat costs O(n^2) tokens over n turns. 16 is eight exchanges.
# The persona, format rules and scenario briefing live in systemInstruction,
# which is stored separately and always re-sent whole, so trimming here ages
# out old conversation, not the tutor's instructions.
MAX_HISTORY_MESSAGES=16

# Ceiling on maxOutputTokens for any request, whatever the caller asks for.
# 2048 is what the app already requests for quiz generation, so nothing it does
# today is affected.
MAX_OUTPUT_TOKENS=2048

# Thinking budget injected when the caller does not specify one. Reasoning
# tokens bill at the output rate, which is 6x the input rate on Gemini, and the
# app sends no config at all for chat -- so before this, every chat turn paid
# for reasoning. 0 is the setting tools/eval validated at 16/16 usable.
#
# Set to `none` for a model that rejects thinkingBudget: 0 -- Gemini 3.5 and
# 3.6 answer it with a 400.
DEFAULT_THINKING_BUDGET=0

# --- Model evaluation (tools/eval) ----------------------------------------
#
# Only `npm run eval` needs this, never the running service. It reaches models
# Google does not serve, so a cheaper candidate can be scored on the real tutor
# prompt before it is adopted. Get one at https://openrouter.ai/keys.
#
# A full run is 16 cases x 3 models and costs well under a cent.
# `npm run eval:mock` exercises the harness with no key and no spend, but note
# it writes to the same tools/eval/results/ directory as a real run.
#
# `npm run eval:prices` needs no key at all — the models endpoint is public.
OPENROUTER_API_KEY=

# --- Primary model, with Gemini as the net -----------------------------------
#
# This is the intended production setup, not an experiment. Set BOTH to serve
# requests from OpenRouter and fall back to Gemini direct whenever OpenRouter
# fails. Leave either blank and the service runs Gemini direct with no fallback,
# which costs about 3x more per turn for no measured gain.
#
# The evidence, from `tools/eval` on 2026-08-31 at 3 samples per case, against
# gemini-3.1-flash-lite (the DEFAULT_MODEL below, which becomes the backup):
#
#   language matrix   48/48 usable  — tied
#   off-topic set     36/36 usable  — tied
#   idiom set         57/60 usable, 59/60 meanings right  (3.1: 60/60, 60/60)
#   cost / 1k turns   $0.17-0.18    (3.1: $0.50-0.60)
#   median latency    ~1.5-1.7s     (3.1: ~1.6-3.0s)
#
# The idiom set is the one with a known right answer, and it is where the
# remaining gap lives: all three losses are Japanese taught to a Chinese
# speaker. Two are explanations that are correct Chinese but heavy with romaji;
# one is a real miss, where "什么意思" was answered with a pronunciation rather
# than a meaning. If that cell matters more later, re-run the idiom set before
# assuming it has gone away.
#
# Why the fallback is not optional: Google has closed 2.5 to new API keys and
# answers them with a 404, so the only route to it is OpenRouter's own account.
# That is a dependency on someone else's access continuing to work.
#
# The app keeps asking for whatever AI_MODEL it was built with; this setting
# overrides what actually answers. So the model can be changed here, on the
# server, without shipping an app update. The spend ledger prices whichever
# model actually served, so the saving shows up in `/healthz` rather than being
# hidden behind the requested id.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# How long to wait on the primary before giving up and trying Gemini.
# Deliberately well under the app's own 30s timeout: the backup needs room for
# a whole second request inside that budget, or the client gives up first and
# the fallback was pointless.
OPENROUTER_TIMEOUT_MS=8000


# Firebase project id, which is what per-account daily allowances need.
#
# The app signs every install in anonymously, so each one already has a uid; it
# sends the resulting ID token in `X-Id-Token` and this is the project the
# token's audience and issuer are checked against. Without it there is no
# identity to meter, and spend is bounded only by RATE_LIMIT_PER_MINUTE (an
# address, which behind carrier NAT can be thousands of unrelated people) and
# DAILY_BUDGET_USD (a total, which one abuser can spend on everyone's behalf).
#
# Verification is done in-process against Google's published certificates — no
# service account, no credentials file, nothing to rotate. See src/identity.js.
#
# The allowances themselves live in src/quotas.js and must agree with the app's
# copy in lib/constants/entitlements.dart, which is what the player is shown.
FIREBASE_PROJECT_ID=
